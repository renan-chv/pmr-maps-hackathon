{
  "name": "roulib-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Roulib native shell (Capacitor) for the App Store and Google Play",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#fff9f1' --splashBackgroundColor '#fff9f1'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
