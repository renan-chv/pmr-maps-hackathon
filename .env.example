# Injected automatically by Aiven Runtime when a PostgreSQL service is attached
DATABASE_URL=
# Free key from https://prim.iledefrance-mobilites.fr (needed for /api/journey)
PRIM_API_KEY=
# Lift polling interval in seconds (default 900 = 15 min)
POLL_SECONDS=900
# Optional area preloaded at startup for the Acceslibre places layer (minLon,minLat,maxLon,maxLat), e.g. Bastille / Marais
PLACES_WARM_BBOX=2.350,48.850,2.380,48.865
